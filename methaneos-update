    log "Удаляем временные файлы..."
    cleanup
    log "Удаление завершено, начинаем установку последней версии..."
    CRITICAL_UPDATE_AVAILABLE=false
   # update_redirect
    #main
}

function apply_regular_update {
    local latest_version="$1"
    log "Начинаю обновление до версии $latest_version..."

    mkdir -p /tmp/update/files
    fetch_version_update_info "$latest_version"
    update_version "$latest_version"

    # Обновляем текущую версию
    echo "$latest_version" > "$METHANEOS_VER"
    log "Обновление успешно завершено. Текущая версия: $latest_version"
    log "Удаляем временные файлы..."
    UPDATE_AVAILABLE=false
    cleanup
}

# Модифицированная функция update_version
function critical_update_version {
    log "Начало процесса обновления до $min_ver"

    local update_json="$UPDATE_JSON"
    local update_url="https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${min_ver}/update.squashfs"
    echo "https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${min_ver}/update.squashfs"

    log "Скачивание образа обновления..."
    wget -q "$update_url" -O "$UPDATE_TMP/update.squashfs" || {
        log "Ошибка загрузки образа"
        exit 1
    }

    perform_update "$update_json"
    echo "min_ver" > "$METHANEOS_VER"
    log "Версия системы успешно обновлена до $min_ver"
    log "Удаляем временные файлы..."
    cleanup
}

# Модифицированная функция update_version
function update_version {
    local target_version="$1"
    log "Начало процесса обновления до $target_version"

    mkdir -p /tmp/update/files
    local update_json="$UPDATE_JSON"
    local update_url="https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${target_version}/update.squashfs"

    log "Скачивание образа обновления..."
    wget -q "$update_url" -O "$UPDATE_TMP/update.squashfs" || {
        log "Ошибка загрузки образа"
        exit 1
    }

    perform_update "$update_json"
    echo "$target_version" > "$METHANEOS_VER"
    log "Версия системы успешно обновлена до $target_version"
    log "Удаляем временные файлы..."
    cleanup
}

# Скачивание обновления
function fetch_update {
    if [[ $critical_update=true ]]; then
        echo  $critical_update
        mkdir -p "$UPDATE_TMP/files/"
        ls -p "$UPDATE_TMP/"
        apply_critical_update
    else
    log "Скачивание файла обновления $target_version"
    #Повышение прав до root, если до сих пор нет
    if [[ $EUID -ne 0 ]]; then
    exec pkexec --disable-internal-agent "$0" "$@"
    fi
    wget -q "$UPDATE_URL" -O "$UPDATE_TMP/update.squashfs"
    mkdir -p "$UPDATE_TMP/files/"

    if [ ! -f "$UPDATE_TMP/update.squashfs" ]; then
        log "Ошибка: файл обновления не найден."
        cleanup
        exit 1
    fi
 fi
}

# Основная логика обновления
function perform_update {
    log "Монтирование обновления..."
    mkdir -p "$MOUNT_POINT"
    mount -o loop "$UPDATE_TMP/update.squashfs" "$MOUNT_POINT"
    ls $MOUNT_POINT

    # Чтение действий из переданного JSON
    local actions=$(jq -c '.actions[]' "$update_json") || {
        log "Ошибка чтения $update_json"
        cleanup
        exit 1
    }

    # Проверка на опасные команды
    function check_dangerous_commands {
    DANGEROUS_COMMANDS=("rm -rf /" "rm -rf /*" ":(){ :|:& };:" "command >/dev/sda")
    for cmd in "${DANGEROUS_COMMANDS[@]}"; do
        if grep -qF "$cmd" "$1"; then
            log "Обнаружена опасная команда: $cmd"
            return 1
        fi
    done
    return 0
    }


    if [[ ! -f "$UPDATE_JSON" ]]; then
        log "Ошибка: файл update.json отсутствует."
        ls $UPDATE_TMP/mount/
        cleanup
        exit 1
    fi

    log "Чтение действий обновления..."
    actions=$(jq -c '.actions[]' "$UPDATE_JSON") || { log "Ошибка чтения update.json!"; cleanup; exit 1; }

    for action in $actions; do
        enabled=$(echo "$action" | jq -r '.enabled // true')
        if [[ "$enabled" != "true" ]]; then
            log "Пропуск действия: $(echo "$action" | jq -r '.type')"
            continue
        fi

            # Действия
    function handle_kernel {
    log "Обновление ядра..."
    local kernel_path="$1"
    local initramfs_path="$2"
    local destination="$3"

    if [[ -f "$kernel_path" && -f "$initramfs_path" ]]; then
        cp "$kernel_path" "$destination/vmlinuz-linux"
        cp "$initramfs_path" "$destination/initramfs-linux.img"
        mkinitcpio -p linux || { log "Ошибка при генерации initramfs."; return 1; }
    else
        log "Ядро или initramfs отсутствуют в обновлении."
    fi
    }

    function handle_pacman {
        log "Обновление пакетов через pacman..."
        local packages=("$@")
        if [[ "${#packages[@]}" -gt 0 ]]; then
            for package in "${packages[@]}"; do
                if [[ ! -f "$package" ]]; then
                    log "Пакет $package не найден. Пропуск."
                    continue
                fi
                sudo pacman -U "$package" --noconfirm || { log "Ошибка обновления пакета $package."; return 1; }
            done
        else
        log "Нет пакетов для обновления."
        fi
        }

        function handle_script {
            log "Выполнение пользовательского скрипта..."
            local script_path="$1"

            if [[ ! -f "$script_path" ]]; then
            log "Ошибка: скрипт $script_path не найден."
            return 1
            fi

            if [[ ! -x "$script_path" ]]; then
            log "Скрипт $script_path не имеет прав на выполнение. Добавляем права..."
            chmod +x "$script_path" || { log "Ошибка изменения прав на $script_path"; return 1; }
            fi

            check_dangerous_commands "$script_path" || { log "Обнаружены опасные команды в $script_path."; return 1; }
            bash "$script_path" || { log "Ошибка выполнения скрипта $script_path."; return 1; }
            }

        type=$(echo "$action" | jq -r '.type')
        case "$type" in
            kernel)
                handle_kernel "$(echo "$action" | jq -r '.path')" \
                              "$(echo "$action" | jq -r '.initramfs')" \
                              "$(echo "$action" | jq -r '.destination')" || update_status="неуспешно"
                ;;
            pacman)
                packages=($(echo "$action" | jq -r '.packages[]'))
                handle_pacman "${packages[@]}" || update_status="неуспешно"
                ;;
            script)
                handle_script "$(echo "$action" | jq -r '.script_path')" || update_status="неуспешно"
                ;;
            *)
                log "Неизвестный тип действия: $type"
                update_status="неуспешно"
                ;;
        esac
    done

    cleanup
    log "Обновление завершено успешно."
}

# Основная функция
function main {
   # cleanup_old_backups
    #fetch_update_info
    #fetch_latest_update_info
    check_update
    update_redirect "$critical_update" "$UPDATE_AVAILABLE"
    #verify_update

    local action="$1"

    # Если действие "check_update" — проверить обновления и завершиться
    if [[ "$action" == "force-update" ]]; then
        force_update  # Ваша функция принудительного обновления
    else
    # Если вызвано с check, выходим
    if [[ "$1" == "check" ]]; then
        cleanup
        exit 0
    fi
    fi
}


# Обработка аргументов командной строки
case "$1" in
    --check|check)
        # Передаем действие "check_update" и завершаем скрипт
        check_update
        ;;
    --force-update|force-update)
        main
        ;;
    --branch)
        # Проверяем, что указано значение ветки
        if [[ -z "$2" ]]; then
            echo "Ошибка: не указана ветка. Допустимые значения: stable, beta, dev" >&2
            exit 1
        fi

        # Проверяем корректность значения
        allowed_branches=("stable" "beta" "dev")
        if [[ ! " ${allowed_branches[@]} " =~ " $2 " ]]; then
            echo "Ошибка: некорректная ветка '$2'. Допустимые значения: ${allowed_branches[*]}" >&2
            exit 1
        fi

        if [[ $EUID -ne 0 ]]; then
        log "Повышение привилегий для выполнения: $0 $*"
        exec pkexec --disable-internal-agent "$0" "$@"
        exit
        fi
        # Заменяем значение BRANCH в конфиге (только последнюю строку)
        sed -i '$ s/BRANCH=.*/BRANCH='"$2"'/' "$CONFIG_FILE"
        echo "Ветка успешно изменена на '$2'"
        exit 0
        ;;
    --apply-critical)
        result=$(check_update)
        IFS='|' read -r critical_update update_available latest_version min_ver <<< "$result"
        [[ "$critical_update" == "true" ]] && apply_critical_update "$min_ver"
        ;;
    *)
        main "default_action"
        ;;
esac

exit 0
