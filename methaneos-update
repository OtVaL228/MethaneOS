#!/bin/bash

set -e  # Завершаем скрипт при любой ошибке

# Константы
CONFIG_FILE="/etc/methaneos/update-config.conf"  # Единый файл конфигурации
UPDATE_TMP="/tmp/update"
MOUNT_POINT="$UPDATE_TMP/mount"
LATEST_UPDATE_INFO_URL="https://otval228.github.io/methaneos_repo/versions/branch/$UPDATE_BRANCH/latest_update.json"
UPDATE_INFO_URL="https://otval228.github.io/methaneos_repo/versions/branch/$branch/$version/update.json"
UPDATE_URL="https://otval228.github.io/methaneos_repo/update.squashfs"
GPG_KEY="/usr/share/update-dir/public.gpg"
LOG_FILE="/var/log/methaneup/update-script.log"
UPDATE_JSON="$UPDATE_TMP/files/update.json"
METHANEOS_VER="/etc/methaneos/methaneos_release"
UPDATE_AVAILABLE=false
CRITICAL_UPDATE_AVAILABLE=false

# Логирование
function log {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" | tee -a "$LOG_FILE"
}

function load_config {
    if [[ -f "$CONFIG_FILE" ]]; then
        source "$CONFIG_FILE"
        # Переименовываем BRANCH из конфига в UPDATE_BRANCH
        UPDATE_BRANCH="$BRANCH"
    else
        log "Конфигурационный файл отсутствует. Используются настройки по умолчанию."
        #Повышение прав до root, если до сих пор нет
        if [[ $EUID -ne 0 ]]; then
        log "Повышение привилегий для выполнения: $0 $*"
        exec pkexec /usr/bin/methaneos-update check --disable-internal-agent "$0" "$@"
        exit
        fi
        # Устанавливаем настройки по умолчанию
        BACKUP_ENABLED=true
        BACKUP_DIR="/var/backups/updates"
        MAX_BACKUPS=5
        MAX_BACKUP_AGE=7
        BRANCH="dev"

        # Создаем конфигурационный файл и записываем настройки
        cat <<EOF > "$CONFIG_FILE"
# Конфигурационный файл для обновлений
# Автоматически создан $(date)

BACKUP_ENABLED=$BACKUP_ENABLED
BACKUP_DIR=$BACKUP_DIR
MAX_BACKUPS=$MAX_BACKUPS
MAX_BACKUP_AGE=$MAX_BACKUP_AGE
UPDATE_BRANCH=$UPDATE_BRANCH
EOF

        log "Конфигурационный файл создан: $CONFIG_FILE"
        load_config
    fi
}

# Очистка временных файлов
function cleanup {
    if [[ $EUID -ne 0 ]]; then
    log "Повышение привилегий для выполнения: $0 $*"
    exec pkexec /usr/bin/methaneos-update check --disable-internal-agent "$0" "$@"
    exit
    fi
    log "Очистка временных файлов..."
    umount "$MOUNT_POINT" 2>/dev/null || true
    rm -rf "$UPDATE_TMP"
}

# Очистка старых резервных копий
function cleanup_old_backups {
    if [[ "$BACKUP_ENABLED" != "true" ]]; then
        return
    fi

    find "$BACKUP_DIR" -type d -mtime +${MAX_BACKUP_AGE:-7} -exec rm -rf {} \; || true
    backups=($(ls -dt "$BACKUP_DIR"/* 2>/dev/null || true))
    while [[ ${#backups[@]} -gt ${MAX_BACKUPS:-5} ]]; do
        log "Удаление старой резервной копии: ${backups[-1]}"
        rm -rf "${backups[-1]}"
        backups=("${backups[@]:0:${#backups[@]}-1}")
    done
}

# Создание резервной копии на основе update.json
function create_backup {
    if [[ "$BACKUP_ENABLED" != "true" ]]; then
        log "Резервное копирование отключено в конфигурации. Пропуск."
        return
    fi

    local backup_dir="$BACKUP_DIR/backup-$(date '+%Y%m%d%H%M%S')"
    mkdir -p "$backup_dir"
    log "Создание резервной копии в каталоге: $backup_dir"
    #Повышение прав до root, если до сих пор нет
    if [[ $EUID -ne 0 ]]; then
    exec pkexec --disable-internal-agent "$0" "$@"
    fi

    local actions=$(jq -c '.actions[]' "$UPDATE_JSON")
    for action in $actions; do
        enabled=$(echo "$action" | jq -r '.enabled // true')
        if [[ "$enabled" != "true" ]]; then
            log "Пропуск действия: $(echo "$action" | jq -r '.type')"
            continue
        fi

        type=$(echo "$action" | jq -r '.type')
        case "$type" in
            kernel)
                log "Пропуск резервного копирования ядра (disabled в update.json)."
                ;;
            pacman)
                log "Резервное копирование пакетов pacman не требуется."
                ;;
            files)
                log "Резервное копирование файлов..."
                files=($(echo "$action" | jq -r '.files_path[]'))
                for file in "${files[@]}"; do
                    if [[ -f "$file" ]]; then
                        dest="$backup_dir$(dirname "$file")"
                        mkdir -p "$dest"
                        cp "$file" "$dest/"
                        log "Сохранён файл: $file"
                    else
                        log "Файл не найден: $file. Пропуск."
                    fi
                done
                ;;
            script)
                log "Пропуск резервного копирования пользовательского скрипта."
                ;;
            *)
                log "Неизвестный тип действия: $type. Пропуск."
                ;;
        esac
    done

    log "Очистка старых резервных копий..."
    cleanup_old_backups
    log "Резервное копирование завершено."
}

# Получение информации о последнем обновлении
function fetch_latest_update_info {
    log "Получение информации о последнем обновлении для ветки $UPDATE_BRANCH"
    LATEST_UPDATE_INFO_URL="https://otval228.github.io/methaneos_repo/versions/branch/$UPDATE_BRANCH/latest_update.json"
    mkdir -p "$UPDATE_TMP"
    wget -q "${LATEST_UPDATE_INFO_URL}?branch=${UPDATE_BRANCH}" -O "$UPDATE_TMP/latest_update.json" || {
        log "Ошибка загрузки latest_update.json"
        cleanup
        exit 1
    }
}

# Получение информации для конкретной версии
function fetch_version_update_info {
    local target_version="$1"
    log "Получение информации для версии $target_version (ветка $UPDATE_BRANCH)"

    local version_update_url="https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${target_version}/update.json"
    wget -q "$version_update_url" -O "$UPDATE_JSON" || {
        log "Ошибка загрузки update.json для версии $target_version"
        exit 1
    }
}

# Обновлённая функция check_update
function version_lt {
    local a=$1 b=$2
    if [ "$a" = "$b" ]; then
        return 1  # Версии равны → false
    fi
    # Возвращаем true, если a < b
    [ "$(printf '%s\n' "$a" "$b" | sort -V | head -n1)" = "$a" ]
}

function check_update {
    load_config
    fetch_latest_update_info

    latest_info="$UPDATE_TMP/latest_update.json"
    latest_version=$(jq -r '.version // ""' "$latest_info")
    min_ver=$(jq -r '.minver // "1.0"' "$latest_info")
    json_update_available=$(jq -r '.update_available | if . == null then "true" else tostring end' "$latest_info")
     [[ -z "$json_update_available" ]] && json_update_available="false"
     # Чтение changelog через jq
     CHANGELOG=$(jq -r '.changelog // empty' "$latest_info")
     # Вывод changelog
     echo -e "\e[32mChangelog:\e[0m $CHANGELOG"

    local current_version=$(tr -d '[:space:]' < "$METHANEOS_VER")

    log "Текущая версия: $current_version | Минимальная: $min_ver | Доступная: $latest_version | Статус обновления: $json_update_available"

    local update_available=false
    local critical_update=false

    if version_lt "$current_version" "$min_ver"; then
        log "Требуется обновление до минимальной версии $min_ver"
        CRITICAL_UPDATE_AVAILABLE=true
        #fetch_version_update_info "$min_ver"
       # update_version "$min_ver"
    #    current_version="$min_ver"
   #   CRITICAL_UPDATE_AVAILABLE= "true"
     #   echo $CRITICAL_UPDATE_AVAILABLE
    fi

    # Проверка актуальной версии
    if version_lt "$current_version" "$latest_version" && [[ "$json_update_available" == "true" ]]; then
        log "Доступно обновление до $latest_version"
        UPDATE_AVAILABLE=true
     elif version_lt "$current_version" "$latest_version" && [[ "$json_update_available" == "false" ]]; then
        log "Обновление $latest_version пока недоступно для скачивания. Повторите попытку позже."
        #UPDATE_AVAILABLE= "true"
       # fetch_version_update_info "$latest_version"
       # update_version "$latest_version"
    else
        log "Система актуальна"
    fi

    # Возвращаем статусы
    #echo "${critical_update}|${update_available}|${latest_version}|${min_ver}"
    return 0;
}

function update_redirect {
    if [[ "$CRITICAL_UPDATE_AVAILABLE" == "true" && "$UPDATE_AVAILABLE" == "true" ]]; then
        if [[ $EUID -ne 0 ]]; then
        exec pkexec --disable-internal-agent "$0" "$@"
        fi
        apply_critical_update $min_ver
        apply_regular_update $latest_version
        exit 0
    elif [[ "$CRITICAL_UPDATE_AVAILABLE" == "true" && "$UPDATE_AVAILABLE" == "false" ]]; then
        if [[ $EUID -ne 0 ]]; then
        exec pkexec --disable-internal-agent "$0" "$@"
        fi
        apply_critical_update
        exit 0
    elif [[ "$CRITICAL_UPDATE_AVAILABLE" == "false" && "$UPDATE_AVAILABLE" == "true" ]]; then
        if [[ $EUID -ne 0 ]]; then
        exec pkexec --disable-internal-agent "$0" "$@"
        fi
        apply_regular_update $latest_version
        exit 0
    elif [[ "$CRITICAL_UPDATE_AVAILABLE" == "false" && "$UPDATE_AVAILABLE" == "false" ]]; then
        exit 0
    else
        echo "Ошибка: неизвестная комбинация условий" >&2
        echo $CRITICAL_UPDATE_AVAILABLE
        echo $UPDATE_AVAILABLE
        exit 1
    fi
}

function apply_critical_update {
    #local critical_update="$1"
    log "Инициирую процесс критического обновления до $min_ver..."

    # Получение информации для конкретной версии
    log "Получение информации для версии $min_ver (ветка $UPDATE_BRANCH)"

    local version_update_url="https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${min_ver}/update.json"
    echo "https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${min_ver}/update.json"
