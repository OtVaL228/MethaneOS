#!/bin/bash

set -euo pipefail

CONFIG_FILE="/etc/methaneos/update-config.conf"
UPDATE_TMP="/tmp/update"
MOUNT_POINT="$UPDATE_TMP/mount"
LATEST_INFO_PATH="$UPDATE_TMP/latest_update.json"
UPDATE_JSON="$UPDATE_TMP/files/update.json"
LOG_FILE="/var/log/methaneup/update-script.log"
METHANEOS_VER="/etc/methaneos/methaneos_release"

UPDATE_AVAILABLE=false
CRITICAL_UPDATE_AVAILABLE=false
LATEST_VERSION=""
MIN_VERSION=""
CURRENT_VERSION=""
AVAILABLE_VERSIONS=()

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_ARGS=("$@")

function log {
    local message="$1"
    mkdir -p "$(dirname "$LOG_FILE")"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${message}" | tee -a "$LOG_FILE" >&2
}

function ensure_root_for_update {
    if [[ $EUID -ne 0 ]]; then
        log "Требуются права root. Перезапуск через pkexec..."
        if command -v pkexec >/dev/null 2>&1; then
            exec pkexec --disable-internal-agent "$SCRIPT_PATH" "${SCRIPT_ARGS[@]}"
        fi
        log "pkexec недоступен. Запустите скрипт с правами root."
        exit 1
    fi
}

function load_config {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
        if [[ -z "${UPDATE_BRANCH:-}" ]]; then
            UPDATE_BRANCH="${BRANCH:-dev}"
        fi
    else
        log "Конфигурационный файл не найден. Создаю файл с настройками по умолчанию."
        local default_branch="dev"
        local default_backup_dir="/var/backups/updates"

        mkdir -p "$(dirname "$CONFIG_FILE")"
        cat <<CFG >"$CONFIG_FILE"
# Конфигурационный файл для обновлений
# Автоматически создан $(date)

BRANCH=$default_branch
UPDATE_BRANCH=$default_branch
BACKUP_ENABLED=true
BACKUP_DIR=$default_backup_dir
MAX_BACKUPS=5
MAX_BACKUP_AGE=7
CFG
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
    fi

    BRANCH="${BRANCH:-${UPDATE_BRANCH:-dev}}"
    UPDATE_BRANCH="${UPDATE_BRANCH:-$BRANCH}"
    BACKUP_ENABLED="${BACKUP_ENABLED:-true}"
    BACKUP_DIR="${BACKUP_DIR:-/var/backups/updates}"
    MAX_BACKUPS="${MAX_BACKUPS:-5}"
    MAX_BACKUP_AGE="${MAX_BACKUP_AGE:-7}"
}

function cleanup {
    if [[ -d "$UPDATE_TMP" ]]; then
        log "Очистка временных файлов..."
        if mountpoint -q "$MOUNT_POINT" 2>/dev/null; then
            umount "$MOUNT_POINT" 2>/dev/null || log "Не удалось размонтировать $MOUNT_POINT"
        fi
        rm -rf "$UPDATE_TMP" 2>/dev/null || log "Не удалось удалить $UPDATE_TMP"
    fi
}

function cleanup_old_backups {
    if [[ "$BACKUP_ENABLED" != "true" ]]; then
        return
    fi

    if [[ -d "$BACKUP_DIR" ]]; then
        find "$BACKUP_DIR" -type d -mtime +"${MAX_BACKUP_AGE}" -exec rm -rf {} \; 2>/dev/null || true
        mapfile -t backups < <(ls -dt "$BACKUP_DIR"/* 2>/dev/null || true)
        while [[ ${#backups[@]} -gt ${MAX_BACKUPS} ]]; do
            local oldest="${backups[-1]}"
            log "Удаление старой резервной копии: $oldest"
            rm -rf "$oldest" 2>/dev/null || true
            backups=("${backups[@]:0:${#backups[@]}-1}")
        done
    fi
}

function fetch_latest_update_info {
    mkdir -p "$UPDATE_TMP"
    local url="https://otval228.github.io/methaneos_repo/versions/branch/$UPDATE_BRANCH/latest_update.json"
    log "Загрузка информации о последнем обновлении ($url)"
    if ! wget -q "$url" -O "$LATEST_INFO_PATH"; then
        log "Не удалось загрузить latest_update.json"
        cleanup
        exit 1
    fi
}

function fetch_version_update_info {
    local target_version="$1"
    mkdir -p "$(dirname "$UPDATE_JSON")"
    local url="https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${target_version}/update.json"
    log "Загрузка информации обновления для версии $target_version"
    if ! wget -q "$url" -O "$UPDATE_JSON"; then
        log "Не удалось загрузить update.json для версии $target_version"
        exit 1
    fi
}

function download_update_image {
    local target_version="$1"
    local url="https://otval228.github.io/methaneos_repo/versions/branch/${UPDATE_BRANCH}/${target_version}/update.squashfs"
    log "Загрузка образа обновления для версии $target_version"
    if ! wget -q "$url" -O "$UPDATE_TMP/update.squashfs"; then
        log "Не удалось загрузить update.squashfs для версии $target_version"
        exit 1
    fi
}

function version_lt {
    local a="$1" b="$2"
    [[ "$a" == "$b" ]] && return 1
    [[ "$(printf '%s\n' "$a" "$b" | sort -V | head -n1)" == "$a" ]]
}

function version_le {
    local a="$1" b="$2"
    [[ "$a" == "$b" ]] && return 0
    version_lt "$a" "$b"
}

function resolve_payload_path {
    local path="$1"
    if [[ -z "$path" ]]; then
        echo ""
    elif [[ "$path" == /* ]]; then
        echo "$path"
    else
        echo "$MOUNT_POINT/$path"
    fi
}

function check_dangerous_commands {
    local script_path="$1"
    local -a dangerous=("rm -rf /" "rm -rf /*" ":(){ :|:& };:" "command >/dev/sda")
    for cmd in "${dangerous[@]}"; do
        if grep -qF "$cmd" "$script_path"; then
            log "Обнаружена опасная команда в $script_path: $cmd"
            return 1
        fi
    done
    return 0
}

function handle_kernel {
    local kernel_path="$(resolve_payload_path "$1")"
    local initramfs_path="$(resolve_payload_path "$2")"
    local destination="$3"

    if [[ -z "$destination" ]]; then
        log "Не указан путь назначения для ядра"
        return 1
    fi

    if [[ -f "$kernel_path" && -f "$initramfs_path" ]]; then
        cp "$kernel_path" "$destination/vmlinuz-linux"
        cp "$initramfs_path" "$destination/initramfs-linux.img"
        if command -v mkinitcpio >/dev/null 2>&1; then
            mkinitcpio -p linux
        fi
    else
        log "Ядро или initramfs отсутствуют в образе обновления"
        return 1
    fi
}

function handle_pacman {
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        log "Нет пакетов для обновления через pacman"
        return 0
    fi

    local resolved=()
    for pkg in "${packages[@]}"; do
        local path="$(resolve_payload_path "$pkg")"
        if [[ -n "$path" ]]; then
            resolved+=("$path")
        fi
    done

    if [[ ${#resolved[@]} -eq 0 ]]; then
        log "Не удалось определить пути пакетов для обновления"
        return 1
    fi

    pacman -U "${resolved[@]}" --noconfirm
}

function handle_script {
    local script_path="$(resolve_payload_path "$1")"
    if [[ ! -f "$script_path" ]]; then
        log "Скрипт $script_path не найден"
        return 1
    fi

    if [[ ! -x "$script_path" ]]; then
        chmod +x "$script_path"
    fi

    check_dangerous_commands "$script_path"
    bash "$script_path"
}

function perform_update {
    local update_json_path="$1"
    if [[ ! -f "$update_json_path" ]]; then
        log "Файл $update_json_path отсутствует"
        exit 1
    fi

    mkdir -p "$MOUNT_POINT"
    log "Монтирование обновления..."
    mount -o loop "$UPDATE_TMP/update.squashfs" "$MOUNT_POINT"

    local update_status="успешно"
    mapfile -t actions < <(jq -c '.actions[]?' "$update_json_path")

    for action in "${actions[@]}"; do
        local enabled
        enabled=$(jq -r '.enabled // true' <<<"$action")
        if [[ "$enabled" != "true" ]]; then
            log "Пропуск действия: $(jq -r '.type' <<<"$action")"
            continue
        fi

        local type
        type=$(jq -r '.type' <<<"$action")
        case "$type" in
            kernel)
                handle_kernel \
                    "$(jq -r '.path' <<<"$action")" \
                    "$(jq -r '.initramfs' <<<"$action")" \
                    "$(jq -r '.destination' <<<"$action")" || update_status="неуспешно"
                ;;
            pacman)
                mapfile -t pkgs < <(jq -r '.packages[]?' <<<"$action")
                handle_pacman "${pkgs[@]}" || update_status="неуспешно"
                ;;
            script)
                handle_script "$(jq -r '.script_path' <<<"$action")" || update_status="неуспешно"
                ;;
            files)
                mapfile -t files < <(jq -c '.files[]?' <<<"$action")
                for file_desc in "${files[@]}"; do
                    local src dst
                    src=$(resolve_payload_path "$(jq -r '.source // empty' <<<"$file_desc")")
                    dst=$(jq -r '.destination // empty' <<<"$file_desc")
                    if [[ -z "$dst" ]]; then
                        log "Не указан путь назначения для файла"
                        update_status="неуспешно"
                        continue
                    fi
                    if [[ -z "$src" || ! -f "$src" ]]; then
                        log "Источник файла $src не найден"
                        update_status="неуспешно"
                        continue
                    fi
                    mkdir -p "$(dirname "$dst")"
                    cp "$src" "$dst"
                done
                ;;
            *)
                log "Неизвестный тип действия: $type"
                update_status="неуспешно"
                ;;
        esac
    done

    umount "$MOUNT_POINT" || log "Не удалось размонтировать $MOUNT_POINT"
    rm -f "$UPDATE_TMP/update.squashfs"

    if [[ "$update_status" != "успешно" ]]; then
        log "Обновление завершилось с ошибками"
        exit 1
    fi
}

function create_backup {
    if [[ "$BACKUP_ENABLED" != "true" ]]; then
        log "Резервное копирование отключено"
        return
    fi

    local backup_dir="$BACKUP_DIR/backup-$(date '+%Y%m%d%H%M%S')"
    mkdir -p "$backup_dir"
    log "Создание резервной копии в $backup_dir"

    mapfile -t actions < <(jq -c '.actions[]' "$UPDATE_JSON" 2>/dev/null || printf '')
    for action in "${actions[@]}"; do
        local type enabled
        enabled=$(jq -r '.enabled // true' <<<"$action")
        if [[ "$enabled" != "true" ]]; then
            continue
        fi
        type=$(jq -r '.type' <<<"$action")
        if [[ "$type" == "files" ]]; then
            mapfile -t files < <(jq -r '.files_path[]?' <<<"$action")
            for file in "${files[@]}"; do
                if [[ -f "$file" ]]; then
                    local dest
                    dest="$backup_dir$(dirname "$file")"
                    mkdir -p "$dest"
                    cp "$file" "$dest/"
                fi
            done
        fi
    done

    cleanup_old_backups
}

function build_version_sequence {
    local current="$1"
    local minimum="$2"
    local target="$3"
    shift 3
    local -a available=("$@")
    local -a candidates=()

    if version_lt "$current" "$minimum"; then
        candidates+=("$minimum")
    fi

    if [[ ${#available[@]} -gt 0 ]]; then
        candidates+=("${available[@]}")
    fi

    candidates+=("$target")

    mapfile -t candidates < <(printf '%s\n' "${candidates[@]}" | awk 'NF' | sort -V | uniq)

    local -a sequence=()
    for version in "${candidates[@]}"; do
        if version_lt "$current" "$version" && version_le "$version" "$target"; then
            sequence+=("$version")
        fi
    done

    printf '%s\n' "${sequence[@]}"
}

function apply_update_sequence {
    local -a versions=("$@")
    if [[ ${#versions[@]} -eq 0 ]]; then
        log "Нет доступных версий для обновления"
        return
    fi

    ensure_root_for_update
    trap cleanup EXIT

    mkdir -p "$UPDATE_TMP/files"

    local first=true
    for version in "${versions[@]}"; do
        log "Начало установки обновления $version"
        fetch_version_update_info "$version"
        if $first; then
            create_backup
            first=false
        fi
        download_update_image "$version"
        perform_update "$UPDATE_JSON"
        echo "$version" >"$METHANEOS_VER"
        CURRENT_VERSION="$version"
        log "Версия системы обновлена до $version"
    done

    trap - EXIT
    cleanup
    log "Цепочка обновлений завершена"
}

function check_update {
    load_config
    fetch_latest_update_info

    CURRENT_VERSION="0"
    if [[ -f "$METHANEOS_VER" ]]; then
        CURRENT_VERSION="$(tr -d '\n\r[:space:]' <"$METHANEOS_VER")"
    fi

    local latest_info="$LATEST_INFO_PATH"
    LATEST_VERSION="$(jq -r '.version // ""' "$latest_info")"
    MIN_VERSION="$(jq -r '.minver // ""' "$latest_info")"
    local json_update_available
    json_update_available="$(jq -r '.update_available // true' "$latest_info")"
    mapfile -t AVAILABLE_VERSIONS < <(jq -r '.available_versions[]?' "$latest_info")

    local changelog
    changelog="$(jq -r '.changelog // empty' "$latest_info")"
    if [[ -n "$changelog" ]]; then
        echo -e "\e[32mChangelog:\e[0m $changelog"
    fi

    log "Текущая версия: $CURRENT_VERSION | Минимальная: $MIN_VERSION | Последняя: $LATEST_VERSION | Доступно: $json_update_available"

    CRITICAL_UPDATE_AVAILABLE=false
    UPDATE_AVAILABLE=false

    if [[ -n "$MIN_VERSION" ]] && version_lt "$CURRENT_VERSION" "$MIN_VERSION"; then
        CRITICAL_UPDATE_AVAILABLE=true
        log "Требуется обновление до минимальной версии $MIN_VERSION"
    fi

    if [[ "$json_update_available" == "true" ]] && [[ -n "$LATEST_VERSION" ]] && version_lt "$CURRENT_VERSION" "$LATEST_VERSION"; then
        UPDATE_AVAILABLE=true
        log "Доступно обновление до версии $LATEST_VERSION"
    elif [[ "$json_update_available" != "true" ]] && version_lt "$CURRENT_VERSION" "$LATEST_VERSION"; then
        log "Версия $LATEST_VERSION пока недоступна для скачивания"
    else
        log "Система актуальна"
    fi
}

function run_default_update {
    check_update

    if [[ "$CRITICAL_UPDATE_AVAILABLE" != "true" && "$UPDATE_AVAILABLE" != "true" ]]; then
        return
    fi

    local target="$CURRENT_VERSION"
    if [[ "$UPDATE_AVAILABLE" == "true" ]]; then
        target="$LATEST_VERSION"
    elif [[ "$CRITICAL_UPDATE_AVAILABLE" == "true" ]]; then
        target="$MIN_VERSION"
    fi

    mapfile -t versions < <(build_version_sequence "$CURRENT_VERSION" "$MIN_VERSION" "$target" "${AVAILABLE_VERSIONS[@]}")
    apply_update_sequence "${versions[@]}"
}

function apply_only_critical {
    check_update
    if [[ "$CRITICAL_UPDATE_AVAILABLE" != "true" ]]; then
        log "Критические обновления отсутствуют"
        return
    fi
    mapfile -t versions < <(build_version_sequence "$CURRENT_VERSION" "$MIN_VERSION" "$MIN_VERSION" "${AVAILABLE_VERSIONS[@]}")
    apply_update_sequence "${versions[@]}"
}

function change_branch {
    local new_branch="$1"
    if [[ -z "$new_branch" ]]; then
        echo "Ошибка: не указана ветка. Допустимые значения: stable, beta, dev" >&2
        exit 1
    fi

    local -a allowed=("stable" "beta" "dev")
    local found=false
    for branch in "${allowed[@]}"; do
        if [[ "$branch" == "$new_branch" ]]; then
            found=true
            break
        fi
    done

    if [[ "$found" != true ]]; then
        echo "Ошибка: некорректная ветка '$new_branch'. Допустимые значения: ${allowed[*]}" >&2
        exit 1
    fi

    ensure_root_for_update

    load_config
    sed -i 's/^BRANCH=.*/BRANCH='"$new_branch"'/' "$CONFIG_FILE"
    sed -i 's/^UPDATE_BRANCH=.*/UPDATE_BRANCH='"$new_branch"'/' "$CONFIG_FILE"
    echo "Ветка успешно изменена на '$new_branch'"
}

case "${1:-}" in
    --check|check)
        check_update
        ;;
    --force-update|force-update)
        run_default_update
        ;;
    --apply-critical)
        apply_only_critical
        ;;
    --branch)
        change_branch "${2:-}"
        ;;
    ""|--update)
        run_default_update
        ;;
    *)
        echo "Неизвестный аргумент: $1" >&2
        echo "Доступные команды: --check, --force-update, --apply-critical, --branch <name>" >&2
        exit 1
        ;;
 esac

exit 0
